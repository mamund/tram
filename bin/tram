#!/usr/bin/env node
'use strict';

/**
 * tram.js v0.1
 *
 * Dependency-free HTTP API test runner.
 *
 * Usage:
 *   tram api-tests.json --validate
 *   tram api-tests.json
 *   tram api-tests.json --verbose
 *   tram api-tests.json --report results.json
 *   tram api-tests.json --transcript transcript.http
 *
 * Requires:
 *   Node.js 18+
 *   ./assertions.js
 */

const fs = require('fs');
const path = require('path');
const { loadManifest, validateManifest, validateManifestPath } = require('../lib/manifest');
const { runSuite } = require('../lib/runner');
const { printConsoleReport, writeJsonReport, writeHttpTranscript } = require('../lib/reports');


async function main() {
  try {
    const args = parseArgs(process.argv.slice(2));
    const manifestPath = validateManifestPath(args.manifestPath);

    validateOutputPath(args.reportPath, 'Report');
    validateOutputPath(args.transcriptPath, 'Transcript');

    const manifest = loadManifest(manifestPath);
    validateManifest(manifest);
  
    if (args.validate) {
      console.log("Manifest is valid. No HTTP requests were made.");
      process.exit(0);
    }
    
    const suiteResult = await runSuite(manifest);

    printConsoleReport(suiteResult, { verbose: args.verbose });

    if (args.reportPath) {
      writeJsonReport(args.reportPath, suiteResult);
    }

    if (args.transcriptPath) {
      writeHttpTranscript(args.transcriptPath, suiteResult);
    }

    process.exit(suiteResult.summary.failed > 0 ? 1 : 0);
  } catch (error) {
    console.error(`ERROR: ${error.message}`);
    process.exit(1);
  }
}

function parseArgs(argv) {
  const args = {
    manifestPath: null,
    verbose: false,
    validate: false,
    reportPath: null,
    transcriptPath: null
  };

  if (argv.length === 0) {
    printUsage();
    process.exit(1);
  }

  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];

    if (arg === '--help' || arg === '-h') {
      printUsage();
      process.exit(0);
    }

    if (arg === '--verbose' || arg === '-v') {
      args.verbose = true;
      continue;
    }

    if (arg === "--validate" || arg === '-c') {
      args.validate = true;
      continue;
    }
    
    if (arg === '--report' || arg === '-r') {
      const reportPath = requireOptionValue(arg, argv[i + 1]);
      args.reportPath = reportPath;
      i += 1;
      continue;
    }

    if (arg === '--transcript' || arg === '-t') {
      const transcriptPath = requireOptionValue(arg, argv[i + 1]);
      args.transcriptPath = transcriptPath;
      i += 1;
      continue;
    }

    if (arg.startsWith('-')) {
      throw new Error(`Unknown option: ${arg}`);
    }

    if (!args.manifestPath) {
      args.manifestPath = arg;
      continue;
    }

    throw new Error(`Unexpected argument: ${arg}`);
  }

  if (!args.manifestPath) {
    throw new Error('Missing manifest file path.');
  }

  return args;
}

function requireOptionValue(option, value) {
  if (!value || value.startsWith('-')) {
    throw new Error(`${option} requires a file path.`);
  }

  return value;
}

function printUsage() {
  console.log('Usage:');
  console.log('  tram <manifest-file> [options]');
  console.log('');
  console.log('Options:');
  console.log('  -v, --verbose              Print passing assertion details');
  console.log('  -r, --report <file>        Write JSON report to file');
  console.log('  -t, --transcript <file>    Write HTTP transcript to file');
  console.log('  -c, --validate             Validate the manifest without making HTTP requests');
  console.log('  -h, --help                 Show help');
  console.log('');
  console.log('Examples:');
  console.log('  tram api-tests.json --validate');
  console.log('  tram api-tests.json');
  console.log('  tram api-tests.json --verbose');
  console.log('  tram api-tests.json --report results.json');
  console.log('  tram api-tests.json --transcript transcript.http');
}

function validateOutputPath(outputPath, label) {
  if (!outputPath) return;

  const fullPath = path.resolve(process.cwd(), outputPath);
  const directory = path.dirname(fullPath);

  if (!fs.existsSync(directory)) {
    throw new Error(`${label} directory does not exist: ${directory}`);
  }

  const stats = fs.statSync(directory);

  if (!stats.isDirectory()) {
    throw new Error(`${label} path parent is not a directory: ${directory}`);
  }
}



main();

